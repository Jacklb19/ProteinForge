# Public configuration. Copy to .env locally; never commit values.
# Identity (sign in, sign up, recovery) is enabled only when both Supabase values are present.
# This variable accepts a public publishable key (sb_publishable_...) or a legacy anon key.
# It grants nothing beyond row-level security; never use a secret or service_role key here.
# Never put server secrets in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
# Saving generator searches in Projects. Leave empty until the API with workspace version 3 is published;
# set to `enabled` only against a local or published API that accepts it.
VITE_GENERATOR_HISTORY=
# Saving reports to the account (Export menu and Projects). Leave empty until the report storage migration
# is applied and the API with ReportService is published; set to `enabled` only against an API that has it.
VITE_REPORT_STORAGE=
# Prediction is opt-in. Requires published folding API and workspace v4 migration; keep empty otherwise.
VITE_STRUCTURE_PREDICTION=
# Automatic retries of projects created without a connection. Leave empty until the API with CreateProject
# request ids and its idempotency migration are published; set to `enabled` only against an API that has them.
VITE_PROJECT_CREATE_IDEMPOTENCY=
