# samconfig.toml.example
# Copiar este archivo a samconfig.toml y configurar los valores propios para despliegue manual.

version = 0.1

[default.build.parameters]
cached = true
parallel = true

[default.deploy.parameters]
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
resolve_s3 = true
s3_prefix = "web-app-template"
region = "us-east-1"
parameter_overrides = "Environment=\"preprod\" AppName=\"web-app-template\""
image_repositories = []
